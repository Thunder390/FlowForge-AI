  },
  "dependencies": {
    "@flowforge/ai": "workspace:*",
    "@flowforge/compiler": "workspace:*",
    "@flowforge/ffir": "workspace:*",
    "@flowforge/registry": "workspace:*"
  },
  "devDependencies": {
    "@flowforge/config": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  }
}
