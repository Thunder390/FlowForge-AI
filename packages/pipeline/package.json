{
  "name": "@flowforge/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The orchestrator. Owns the generation state machine, and is the only package allowed to import both the AI layer and the compiler.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
