{
  "name": "@flowforge/registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Loads and serves built registry artifacts: capability definitions, platform bindings, and the retrieval index. Does not build them.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures": "./src/__fixtures__/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flowforge/ffir": "workspace:*",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@flowforge/config": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  }
}
