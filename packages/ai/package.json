{
  "name": "@flowforge/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prompts, providers, generation passes, and the registry-dependent validation stages. Must not import the compiler: the AI layer produces FFIR and knows nothing about any target platform.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flowforge/ffir": "workspace:*",
    "@flowforge/registry": "workspace:*"
  },
  "devDependencies": {
    "@flowforge/config": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  }
}
